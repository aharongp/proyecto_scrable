<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <!-- Encabezado -->
    <top>
        <Label text="Estadísticas de Partidas" style="-fx-font-size: 36px; -fx-padding: 20; -fx-alignment: center;" BorderPane.alignment="CENTER"/>
    </top>

    <!-- Contenido principal -->
    <center>
        <VBox spacing="25" alignment="CENTER" style="-fx-padding: 40;">
            <HBox spacing="20" alignment="CENTER">
                <Label text="Jugador 1:" style="-fx-font-size: 18px;"/>
                <TextField fx:id="campoJugador1" promptText="Alias Jugador 1" style="-fx-font-size: 16px; -fx-pref-width: 200px;"/>
                <Label text="Puntos:" style="-fx-font-size: 18px;"/>
                <TextField fx:id="campoPuntosJugador1" promptText="Puntos Jugador 1" style="-fx-font-size: 16px; -fx-pref-width: 200px;"/>
                <Label text="Palabras:" style="-fx-font-size: 18px;"/>
                <TextField fx:id="campoPalabrasJugador1" promptText="Palabras Jugador 1" style="-fx-font-size: 16px; -fx-pref-width: 200px;"/>
            </HBox>
            <HBox spacing="20" alignment="CENTER">
                <Label text="Jugador 2:" style="-fx-font-size: 18px;"/>
                <TextField fx:id="campoJugador2" promptText="Alias Jugador 2" style="-fx-font-size: 16px; -fx-pref-width: 200px;"/>
                <Label text="Puntos:" style="-fx-font-size: 18px;"/>
                <TextField fx:id="campoPuntosJugador2" promptText="Puntos Jugador 2" style="-fx-font-size: 16px; -fx-pref-width: 200px;"/>
                <Label text="Palabras:" style="-fx-font-size: 18px;"/>
                <TextField fx:id="campoPalabrasJugador2" promptText="Palabras Jugador 2" style="-fx-font-size: 16px; -fx-pref-width: 200px;"/>
            </HBox>
            <HBox spacing="20" alignment="CENTER">
                <Label text="Ganador:" style="-fx-font-size: 18px;"/>
                <TextField fx:id="campoGanador" promptText="Alias del Ganador" style="-fx-font-size: 16px; -fx-pref-width: 200px;"/>
            </HBox>
            <HBox spacing="20" alignment="CENTER">
                <Label text="Duración de la Partida:" style="-fx-font-size: 18px;"/>
                <TextField fx:id="campoDuracion" promptText="Ej: 1h 20m" style="-fx-font-size: 16px; -fx-pref-width: 200px;"/>
            </HBox>
        </VBox>
    </center>

    <!-- Pie de página -->
    <bottom>
        <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20;">
            <Button text="Estadísticas" fx:id="btnEstadisticas" style="-fx-font-size: 16px; -fx-pref-width: 150px;"/>
            <Button text="Regresar" fx:id="btnRegresar" style="-fx-font-size: 16px; -fx-pref-width: 150px;"/>
        </HBox>
    </bottom>
</BorderPane>
